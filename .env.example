# API Configuration
# Choose one: 'openai' or 'gemini'
VITE_AI_PROVIDER=gemini

# Cloudflare Worker API URL
# After deploying the worker, replace with your worker URL
# Example: https://right-emoji-api.YOUR-SUBDOMAIN.workers.dev
VITE_API_URL=http://localhost:8787

# Note: API keys are now stored in Cloudflare Worker secrets
# No need to store them here anymore!
